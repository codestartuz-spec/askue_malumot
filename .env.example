# ASKUE ma'lumot — Docker sozlamalari. bash deploy.sh birinchi ishga tushganda shu fayldan .env yaratadi
# va parollarni o'zi tasodifiy qilib to'ldiradi. Quyidagilarni qo'lda ham o'zgartirsa bo'ladi.

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
SECRET_KEY=
SADMIN_USERNAME=sadmin
SADMIN_PASSWORD=

TZ=Asia/Tashkent
TOKEN_HOURS=12
INNODB_BUFFER_POOL=512M

# Cloudflare Tunnel tokeni (Zero Trust → Networks → Tunnels → tunnelingiz → token). Bo'sh bo'lsa tunnel yoqilmaydi.
CLOUDFLARE_TUNNEL_TOKEN=

# Server tashqi tarmoqqa proxy orqali chiqsa (odatda kerak emas)
TELEGRAM_PROXY=
TELEGRAM_API=https://api.telegram.org

# Portni tashqariga ochish (tunnel bo'lsa 127.0.0.1 qoldiring)
API_BIND=127.0.0.1
API_PORT=8000
